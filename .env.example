# ── Telegram ──────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
ALLOWED_USER_IDS=your_telegram_user_id

# ── LLM Provider — pick ONE ───────────────────────────────

# Option A: OpenRouter (recommended — 100+ models, one key)
PROVIDER=openrouter
OPENAI_API_KEY=sk-or-your-openrouter-key
OPENAI_BASE_URL=https://openrouter.ai/api/v1
MODEL=minimax/minimax-m2.5

# Option B: Groq (free tier)
# PROVIDER=groq
# GROQ_API_KEY=gsk_...
# MODEL=llama3-8b-8192
# OPENAI_BASE_URL=

# Option C: OpenAI
# PROVIDER=openai
# OPENAI_API_KEY=sk-...
# MODEL=gpt-4o-mini
# OPENAI_BASE_URL=

# Option D: Anthropic
# PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# MODEL=claude-haiku-4-5-20251001
# OPENAI_BASE_URL=

# ── Assistant ─────────────────────────────────────────────
SYSTEM_PROMPT=You are a concise, helpful personal assistant. Be direct and clear.
MAX_HISTORY=20

# ── Web Search ────────────────────────────────────────────
# Free tier: 2000 queries/month — https://brave.com/search/api/
BRAVE_API_KEY=
SEARCH_AUTO=true
CRAWL_MAX_CHARS=4000
SEARCH_RESULTS=5

# ── CLI Execution ─────────────────────────────────────────
# Full environment access — all commands run as the bot's OS user.
# Only catastrophically destructive commands are hard-blocked
# (rm -rf, disk wipes, fork bombs, remote-pipe execution).
ALLOW_ANY_COMMAND=true
CLI_TIMEOUT_MS=15000
CLI_MAX_OUTPUT=3000

# ── Agentic Tool Execution ────────────────────────────────
# Allow the model to call tools (run commands, search, etc.)
# Set to false to disable tool use entirely
ENABLE_TOOLS=true

# ── Vision (Image Understanding) ─────────────────────────
# Model must support vision — gemini-flash-1.5 works on OpenRouter for free
VISION_MODEL=google/gemini-flash-1.5
VISION_MAX_TOKENS=1024

# ── Timezone (for reminder times) ────────────────────────
# Used to display reminder fire times in your local time
# Full list: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TIMEZONE=Asia/Kolkata
