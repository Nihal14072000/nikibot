# ── Telegram ──────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather

# ── LLM Provider — pick ONE and fill it in ────────────────
# Option A: OpenAI
PROVIDER=openai
OPENAI_API_KEY=sk-...
MODEL=gpt-4o-mini          # cheap, fast, smart

# Option B: Groq (free tier, very fast)
# PROVIDER=groq
# GROQ_API_KEY=gsk_...
# MODEL=llama3-8b-8192

# Option C: Anthropic
# PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# MODEL=claude-haiku-4-5-20251001

# ── Assistant personality ──────────────────────────────────
SYSTEM_PROMPT=You are a concise, helpful personal assistant. Be direct and clear.

# ── Limits ────────────────────────────────────────────────
# How many past messages to keep per conversation (controls RAM + token usage)
MAX_HISTORY=20

# Optional: restrict bot to specific Telegram user IDs (comma-separated)
# Leave blank to allow anyone who messages the bot
ALLOWED_USER_IDS=

# ── Web Search (Brave Search API) ─────────────────────────
# Free tier: 2000 queries/month — https://brave.com/search/api/
BRAVE_API_KEY=

# Auto-search: bot decides when to search based on your message
# Set to false to only search when you use /search command explicitly
SEARCH_AUTO=true

# Max characters to extract when crawling a webpage (default 4000)
CRAWL_MAX_CHARS=4000

# Number of search results to fetch per query (default 5)
SEARCH_RESULTS=5

# ── CLI Execution ──────────────────────────────────────────
# Allow the bot to run shell commands via /run and /shell

# ⚠️  DANGER: Set to true to allow ANY shell command (personal use only)
# When false (default), only commands matching the allowlist in tools/cli.js are allowed
ALLOW_ANY_COMMAND=false

# Timeout per command in milliseconds (default: 15000 = 15s)
CLI_TIMEOUT_MS=15000

# Max characters of output to send back to Telegram (default: 3000)
CLI_MAX_OUTPUT=3000
